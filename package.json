{
  "name": "prod-account-setup",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop helper for the production Digital Transport Documents account setup guide.",
  "author": "Trimble",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.trimble.transportation.prod-account-setup",
    "productName": "Prod Account Setup",
    "artifactName": "prod-account-setup-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
